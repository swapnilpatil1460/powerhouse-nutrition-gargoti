# Meta / Facebook Graph API Credentials
# 1. Get your Page ID from: Facebook Page > About > Page Transparency (or Page Details)
# 2. Generate a long-lived Page Access Token via Meta for Developers (Graph API Explorer)
#    Required permissions: pages_manage_posts, pages_read_engagement, pages_show_list

PAGE_ID=your_facebook_page_id_here
PAGE_ACCESS_TOKEN=your_page_access_token_here
GRAPH_API_VERSION=v19.0
